# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NVIDIA_API_KEY: Single unified key required for all NVIDIA NIM models active in HASEX AI (Strategy/Journal/Code modes).
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# SPEECH_TO_TEXT_API_KEY: Required for Speech-to-Text services.
SPEECH_TO_TEXT_API_KEY="MY_SPEECH_TO_TEXT_API_KEY"

# SYNTHETIC_DATA_API_KEY: Required for Synthetic Data Generation.
SYNTHETIC_DATA_API_KEY="MY_SYNTHETIC_DATA_API_KEY"

# Supabase Configuration
# Get these values from your Supabase Project Settings > API
VITE_SUPABASE_URL="MY_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Sentry Configuration
# Get your DSN from Sentry.io > Projects > Settings > Client Keys (DSN)
VITE_SENTRY_DSN="YOUR_SENTRY_DSN"
# Get your auth token from Sentry.io > User Settings > Auth Tokens
SENTRY_AUTH_TOKEN="YOUR_SENTRY_AUTH_TOKEN"

